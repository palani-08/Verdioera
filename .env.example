# ─────────────────────────────────────────────────────────────
# Simply Paper — environment variables
# Copy to .env.local for local development. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Public site URL (no trailing slash). Used for canonical URLs, Open Graph,
# sitemap.xml and robots.txt. On Vercel this falls back to the production domain.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Set to "false" on staging/preview deployments to block search engine indexing.
NEXT_PUBLIC_ALLOW_INDEXING=true

# Show "To confirm: …" placeholders for unconfirmed business information
# (contact details, facility facts, specifications). Use "true" on staging only.
NEXT_PUBLIC_SHOW_CONTENT_PLACEHOLDERS=false

# ── Enquiry delivery ─────────────────────────────────────────
# Configure at least one channel. With none configured, the enquiry form is
# disabled with an honest "not connected" notice and the API returns 503.

# Email via Resend (https://resend.com). The FROM address must use a domain
# verified in your Resend account. TO accepts a comma-separated list.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL="Simply Paper Website <enquiries@example.com>"

# Optional webhook (CRM, Zapier, Make, n8n, etc.). Receives a JSON POST.
# The secret, if set, is sent in the X-Enquiry-Secret header.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=

# Local development only: log enquiries to the server console instead of
# delivering them. Ignored in production builds.
ENQUIRY_DEV_LOG=false
